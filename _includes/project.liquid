---
layout: default
---
<article class="project">
  <header class="project-header">
    <h1>{{ title }}</h1>
  </header>
  <div class="project-body">
    {{ content }}
    {% for image in images %}
      <img src="{{ image }}" alt="{{ title }}" class="project-image" loading="lazy">
    {% endfor %}
  </div>
</article>
