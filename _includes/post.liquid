---
layout: default
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <time class="post-date">{{ page.date | date: "%B %d, %Y" }}</time>
    {% if copyright %}
    <p class="post-copyright">{{ copyright }}</p>
    {% endif %}
  </header>
  {% if bigshot %}
  <img class="post-hero" src="/media/blog/{{ page.fileSlug }}/{{ bigshot }}" alt="{{ title }}" loading="lazy">
  {% endif %}
  <div class="post-body">
    {{ content }}
  </div>
</article>
